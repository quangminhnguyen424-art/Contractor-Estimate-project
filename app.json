{
  "expo": {
    "name": "Estimator",
    "slug": "estimating-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "estimatingapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ymllc.estimator",
      "infoPlist": {
        "NSCameraUsageDescription": "Take job photos and scan rooms with LiDAR to draw floor plans for your estimate.",
        "NSPhotoLibraryUsageDescription": "Attach job photos to your estimate.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ymllc.estimator"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Talk to the assistant and describe jobs by voice.",
          "speechRecognitionPermission": "Turn what you say into text for the assistant and your estimates.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
